{
  "manifest_version": 3,
  "name": "AlettaGAP — Parameter & Endpoint Hunter",
  "version": "1.1.0",
  "description": "Passively extract hidden parameters, API endpoints, secrets and wordlists from pages and JS bundles. Sus-param classification, Next.js RSC apiPaths, sourcemap mining, traceable fuzz-value join export.",
  "permissions": [
    "storage",
    "scripting",
    "downloads",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open AlettaGAP panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "secrets_patterns.json",
        "params_data.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
